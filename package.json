{
    "name": "plurid-engine-workspace",
    "version": "0.0.0",
    "private": true,
    "description": "Plurid engine monorepo root. Overrides + allowBuilds live in pnpm-workspace.yaml (pnpm 11 no longer reads the package.json pnpm field). plurid-canvas + plurid-html are archived (excluded in pnpm-workspace.yaml), so the recursive scripts below no longer need to filter them.",
    "packageManager": "pnpm@11.3.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "pnpm -r build",
        "check": "pnpm -r check",
        "check.modules": "node scripts/check-modules.mjs",
        "smoke.pack": "node scripts/smoke-pack.mjs",
        "test": "pnpm -r test",
        "lint": "eslint packages/plurid-web/plurid-core packages/plurid-web/plurid-works packages/plurid-utilities fixtures/render-test/src",
        "format": "prettier --write \"packages/**/source/**/*.{ts,tsx}\" \"fixtures/**/src/**/*.{ts,tsx}\"",
        "format.check": "prettier --check \"packages/**/source/**/*.{ts,tsx}\" \"fixtures/**/src/**/*.{ts,tsx}\"",
        "e2e": "pnpm --filter plurid-render-test e2e",
        "verify": "pnpm build && pnpm check && pnpm test && pnpm lint && pnpm check.modules && pnpm --filter plurid-render-test e2e && pnpm smoke.pack",
        "docs.tables": "node scripts/generate-tables.mjs",
        "docs.tables.check": "node scripts/generate-tables.mjs --check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.5.0",
        "globals": "^17.6.0",
        "prettier": "^3.6.2",
        "typescript-eslint": "^8.61.1"
    }
}
